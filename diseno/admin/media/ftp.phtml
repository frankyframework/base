                                        var pourc = Math.round(e.loaded / e.total * 100);
                                        progressbar.progressbar( "value", pourc );
                                }


                        } , false);
                    }
                    return xhr;
                },

        });

    }
    $(document).ready(function()
    {
        $('#fileloadbutton').on('change', function(e)
