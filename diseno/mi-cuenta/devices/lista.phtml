    });
 });

 function creadorDeBotones(cellvalue, options, rowObject) {
    
    var id = options.rowId; // Obtiene el ID único de la fila actual
     
    var icon_delete = (rowObject.status  == "activar" ? 'icon-c-encender' : 'icon-r-eliminar');
    var boton1 = '<a class="_btn_adm_eliminar " data-id="'+id+'" href="#desactivar"><span class="icon icon-r-eliminar"> </span></a> ';
    var boton2 = '<a class="btn_adm_eliminar_switch_device" data-id="'+id+'" href="#'+rowObject.status+'"><span class="icon '+icon_delete+'"> </span></a>';
    
    return boton1 + boton2;                       
}


function deleteDevices() {
    $.fn.buttonDelete('a.btn_adm_eliminar_switch_device')
    
    $(".btn_adm_eliminar_switch_device").click(function(event){
        event.preventDefault();
        var nuevo_estado = ($(this).attr("href").replace("#","") == "activar" ? 1 : 0);
        EliminarDevice('BloquearDispositivo',$(this).attr("data-id"),nuevo_estado,'',"EliminarRegistroPanel")

        
    });

    $("._btn_adm_eliminar").click(function(event){
        event.preventDefault();
        EliminarDevice('EliminarDispositivo',$(this).attr("data-id"),0,'¿Realmente quieres eliminar el dispositivo?',"EliminarRegistorPanelRemove")

    });
}

function showChildGrid(parentRowID, parentRowKey) {
    var childGridID = parentRowID + "_table";
    var childGridPagerID = parentRowID + "_pager";

        var agent  = $(this).find('#' + parentRowKey + ' td[aria-describedby$="_user_agent"]').text();
      
        $('#' + parentRowID).append('<p>User Agent: '+agent+'</p>');
       
    
}
</script>
