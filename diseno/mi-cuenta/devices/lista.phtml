        redirectPath : '',
        pathData : window.location.pathname,
        error : "<?=_calificaciones("No hay registros")?>",
        deleteFunction : "",
        colModel: [
            { label: '<?=_('ID')?>', name: 'id', key:true, hidden:true, width: 50 },
            { label: '<?=_('Fecha')?>', name: 'access_last', width: 150,
                
                searchoptions: {
                    dataInit: function (element) {
                        $(element).datepicker({
                            id: 'orderDate_datePicker',
                            dateFormat:"yy-mm-dd",
                            maxDate: "+0D",
                            showOn: 'focus'
                        });
                    },
                    sopt: ["ge","le","eq"]
                }
            },
            { label: '<?=_('Tipo')?>', name: 'type', width: 100 },
            { label: '<?=_('OS')?>', name: 'os',  width: 100},
