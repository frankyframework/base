<script>
$( "#users" ).validate({
rules: {
    email: {
        required: true,
        email: true,
        remote: {
            url: "/registro/email.php",
            type: "post",
            data: {
                email: function() {
                    return $( "input[name=email]" ).val();
                }
            }
        }
    },
    nombre: {
            required: true,
            'name-validation': true
    },
    fecha_nacimiento: {
            required: true,
    },
    contrasena: {
            required: true,
            minlength: <?=getCoreConfig('base/user/passwordlength')?>
    },
    contrasena1: {
            required: true,
            minlength: <?=getCoreConfig('base/user/passwordlength')?>,
            equalTo: "#contrasena"
    },
    acepto: {
            required: true
    }
},
messages: {
    nombre: {
              required: "Escribe tu nombre completo",
              'name-validation': 'El campo nombre contiene caracteres no permitidos'
              },
    fecha_nacimiento: {
        required: "Favor de seleccionar tu fecha de nacimiento",
    },
    contrasena: {
            required: "Escribe tu contrase&ntilde;a",
            rangelength: jQuery.validator.format("Tu contrase&ntilde;a debe tener mínimo {0} caracteres")
    },
    contrasena1: {
